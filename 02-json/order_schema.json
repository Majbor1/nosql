{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "orderId": {
      "type": "string"
    },
    "customer": {
      "type": "object",
      "properties": {
        "fullName": {
          "type": "string"
        },
        "email": {
          "type": "string",
          "format": "email"
        }
      },
      "required": ["fullName", "email"]
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "sku": {
            "type": "string"
          },
          "quantity": {
            "type": "integer",
            "minimum": 1
          },
          "unitPrice": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        },
        "required": ["sku", "quantity", "unitPrice"]
      }
    },
    "status": {
      "type": "string",
      "enum": ["pending", "shipped", "delivered", "cancelled"]
    }
  },
  "required": ["orderId", "customer", "items", "status"]
}